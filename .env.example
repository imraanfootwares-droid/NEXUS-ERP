# ==============================================================================
# Nexus ERP — Environment Configuration
# Copy to .env.local for local development or configure in Vercel / VPS Docker.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Hosting & App Domain
# ------------------------------------------------------------------------------
DEPLOYMENT_TARGET=vercel
NEXT_PUBLIC_APP_DOMAIN=localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Application Owner (Super Admin Bootstrap)
# ------------------------------------------------------------------------------
APP_OWNER_EMAIL=owner@nexuserp.in
APP_OWNER_NAME=Mohammad Hassan
APP_OWNER_BOOTSTRAP_TOKEN=change-me-to-a-long-random-token

# ------------------------------------------------------------------------------
# 3. Neon / PostgreSQL (Pure Postgres — Neon today, VPS Postgres tomorrow)
# ------------------------------------------------------------------------------
# Pooled connection string for runtime (connects as restricted nexus_app role)
DATABASE_URL=postgresql://nexus_app:change_app_password@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Direct owner connection string for migrations & CLI scripts only
DATABASE_URL_MIGRATE=postgresql://neondb_owner:change_owner_password@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Password assigned to the nexus_app role during `npm run db:migrate`
NEXUS_APP_DB_PASSWORD=change_app_password
# Optional: separate Neon test branch or local Docker Postgres for `npm run test:db`
TEST_DATABASE_URL=

# ------------------------------------------------------------------------------
# 4. Authentication & Security
# ------------------------------------------------------------------------------
# Minimum 32-character random secret for HS256 JWT session & impersonation cookies
AUTH_SECRET=replace-with-at-least-32-character-random-secret-key
# Secret for /api/cron/daily-backup (`Authorization: Bearer <CRON_SECRET>`)
CRON_SECRET=replace-with-cron-bearer-secret

# ------------------------------------------------------------------------------
# 5. S3-Compatible Object Storage (Cloudflare R2 today -> MinIO/S3 on VPS)
# ------------------------------------------------------------------------------
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=your-r2-access-key-id
S3_SECRET_ACCESS_KEY=your-r2-secret-access-key
# Two separate buckets: public for product images/logos, private for backups/imports
S3_BUCKET_PUBLIC=nexus-public
S3_BUCKET_PRIVATE=nexus-private
# Cloudflare R2 custom CDN domain (never use r2.dev in production)
S3_PUBLIC_URL=https://cdn.nexuserp.in
